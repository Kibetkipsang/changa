generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  memberships   Membership[]
  contributions Contribution[]
  loans         Loan[]
}

model Chama {
  id                String   @id @default(cuid())
  name              String
  description       String?
  inviteCode        String   @unique
  contributionAmount Float?
  frequency         String   @default("monthly")
  penaltyAmount     Float?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  memberships   Membership[]
  contributions Contribution[]
  loans         Loan[]
  meetings      Meeting[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  chamaId   String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chama  Chama  @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  
  @@unique([userId, chamaId])
}

model Contribution {
  id         String   @id @default(cuid())
  userId     String
  chamaId    String
  amount     Float
  month      DateTime
  status     String   @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  paymentMethod String? @default("CASH") // CASH, MPESA, BANK_TRANSFER
  notes      String?
  recordedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  user  User  @relation(fields: [userId], references: [id])
  chama Chama @relation(fields: [chamaId], references: [id])
}

model Loan {
  id              String   @id @default(cuid())
  userId          String
  chamaId         String
  amount          Float
  interestRate    Float    @default(0)
  repaymentPeriod Int      // Months
  balance         Float
  purpose         String?  // What the loan is for
  status          String   @default("PENDING") // PENDING, APPROVED, ACTIVE, COMPLETED, DEFAULTED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user       User            @relation(fields: [userId], references: [id])
  chama      Chama           @relation(fields: [chamaId], references: [id])
  repayments LoanRepayment[]
}

model LoanRepayment {
  id         String   @id @default(cuid())
  loanId     String
  amount     Float
  date       DateTime @default(now())
  recordedBy String
  notes      String?
  createdAt  DateTime @default(now())
  
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Meeting {
  id              String   @id @default(cuid())
  chamaId         String
  title           String
  description     String?
  date            DateTime
  location        String?  // Physical or virtual meeting location
  type            String   @default("REGULAR") // REGULAR, SPECIAL, AGM
  agenda          String?  // Can be JSON string or text
  minutes         String?  // Meeting minutes/notes after meeting
  attendanceList  String?  // JSON array of user IDs who attended
  status          String   @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  chama Chama @relation(fields: [chamaId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  chamaId   String
  userId    String
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())
}